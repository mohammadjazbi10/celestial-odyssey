{
    "project": "Celestial Odyssey",
    "experiment_stage": "initial_10_star_pilot",
    "feature_columns": [
        "mad",
        "standard_deviation",
        "skewness",
        "kurtosis",
        "amplitude"
    ],
    "feature_scaler": "RobustScaler",
    "scaling_quantile_range": [
        25.0,
        75.0
    ],
    "random_seed": 42,
    "isolation_forest": {
        "n_estimators": 300,
        "max_samples": "auto",
        "contamination": "auto",
        "max_features": 1.0,
        "bootstrap": false,
        "random_state": 42,
        "n_jobs": 4
    },
    "local_outlier_factor": {
        "n_neighbors": 9,
        "algorithm": "auto",
        "metric": "minkowski",
        "p": 2,
        "contamination": "auto",
        "novelty": false,
        "n_jobs": 4
    },
    "lof_novelty": false,
    "lof_score_direction": "Higher negated negative_outlier_factor means more anomalous",
    "if_score_direction": "Higher negated decision_function means more anomalous",
    "gpu_used_for_these_models": false,
    "number_of_training_stars": 10,
    "ml_features": [
        "mad",
        "standard_deviation",
        "skewness",
        "kurtosis",
        "amplitude"
    ]
}